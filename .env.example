# InsightFace Server
WCM_INSIGHTFACE_BASE_URL=http://10.252.25.251:18097
WCM_INSIGHTFACE_COLLECTION_ID=all-persons
WCM_INSIGHTFACE_API_KEY=
WCM_INSIGHTFACE_TIMEOUT_S=10
WCM_INSIGHTFACE_VERIFY_SIMILARITY_THRESHOLD=0.5
WCM_IMAGE_DIR=/tmp/wcm
WCM_BUILD_NETWORK=default
WCM_MYSQL_PORT=13306

# Review task MySQL (Docker Compose enables persistence automatically)
WCM_REVIEW_TASKS_DB_NAME=wcm
WCM_REVIEW_TASKS_DB_USER=wcm
WCM_REVIEW_TASKS_DB_PASSWORD=wcm
WCM_MYSQL_ROOT_PASSWORD=wcm-root

# API Configuration
WCM_API_HOST=0.0.0.0
WCM_API_PORT=8000
WCM_MAX_FILE_SIZE_MB=100
# Shared across API workers in one container; excess reviews wait for a slot.
WCM_REVIEW_TASK_CONCURRENCY=4
# Active sampling windows per video review.
WCM_REVIEW_WINDOW_CONCURRENCY=2
WCM_VISUAL_TIMEOUT_S=30
WCM_OCR_TIMEOUT_S=10
WCM_GUARD_TIMEOUT_S=10

# Media moderation model gateway
WCM_NSFW_IMAGE_MODE=auto
WCM_NSFW_VERIFY_TARGET=false
# Keep visual context within shots; only skip near-duplicate visual targets.
# Face/OCR still use sample_interval. Set fixed to restore stride-one windows.
WCM_NSFW_SAMPLING_MODE=scene
WCM_NSFW_SCENE_MAX_STRIDE=3
WCM_NSFW_SCENE_CUT_THRESHOLD=27
WCM_NSFW_REVIEW_MODE=window
WCM_NSFW_WINDOW_MAX_SECONDS=10
WCM_MODEL_API_URL=https://models.example.com/v1/chat/completions
WCM_MODEL_API_KEY=
