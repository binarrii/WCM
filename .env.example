# Bootstrap / infrastructure only. Runtime business parameters are seeded into
# system_parameters and managed from the 参数配置 page.
WCM_BUILD_NETWORK=default
WCM_MYSQL_PORT=13307
WCM_HTTP_PORT=8000

# Review task MySQL (Docker Compose enables persistence automatically)
WCM_REVIEW_TASKS_DB_NAME=wcm
WCM_REVIEW_TASKS_DB_USER=wcm
WCM_REVIEW_TASKS_DB_PASSWORD=wcm
WCM_MYSQL_ROOT_PASSWORD=wcm-root

# API Configuration
WCM_API_HOST=0.0.0.0
WCM_API_PORT=8000

# Authentication: keep the Fernet encryption key identical on every API replica.
# Generate: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
WCM_AUTH_SECRET_KEY=replace-with-generated-fernet-key
WCM_AUTH_ORIGINS=["http://10.252.25.251:8000","https://wcmcore.ai-t.wtvdev.com"]
WCM_AUTH_RP_ID=wcmcore.ai-t.wtvdev.com
# Mixed HTTP/HTTPS: false permits LAN HTTP; trusted HTTPS origins still get Secure cookies.
WCM_AUTH_COOKIE_SECURE=false
WCM_AUTH_SESSION_HOURS=12
# For HTTPS-only deployments, remove the HTTP origin and force Secure cookies:
# WCM_AUTH_COOKIE_SECURE=true

# Compose enables cluster mode, MySQL, Redis and S3 for API/Worker.
WCM_CLUSTER_ENABLED=true
WCM_INSIGHTFACE_REPLICATION_ENABLED=false
# Optional: only used when explicitly adding compose.cpu-limits.yaml.
# WCM_API_CPUS=2
# WCM_WORKER_CPUS=2
# WCM_FACE_SYNC_CPUS=1
# WCM_IFS_REPLICA_CPUS=4
WCM_INSIGHTFACE_REPLICAS={"a":"http://insightface-a:8080","b":"http://insightface-b:8080"}
# Pin this to the exact existing primary image when enabling the replica overlay.
WCM_IFS_REPLICA_IMAGE=ghcr.io/deepinsight/insightface-server:0.2.0-cpu
WCM_CLUSTER_NAMESPACE=wcm-cluster
WCM_REDIS_URL=redis://redis:6379/0
WCM_WORKER_CONCURRENCY=2
WCM_REVIEW_LEASE_SECONDS=60
WCM_REVIEW_HEARTBEAT_SECONDS=5
WCM_REVIEW_MAX_ATTEMPTS=3
WCM_REVIEW_RETRY_SECONDS=5
WCM_WORKER_SHUTDOWN_SECONDS=120

# Private S3-compatible object storage (RustFS on 251).
WCM_IMAGE_STORAGE=s3
WCM_S3_ENDPOINT=http://10.252.25.251:9000
WCM_S3_REGION=us-east-1
WCM_S3_BUCKET=wcm-dev
WCM_S3_PREFIX=wcm/images
WCM_S3_ACCESS_KEY=replace-me
WCM_S3_SECRET_KEY=replace-me
